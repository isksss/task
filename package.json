{
  "name": "task",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @task/web build && pnpm --filter @task/api dev",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --filter @task/web build && pnpm --filter @task/api build",
    "test": "pnpm --filter @task/api test && pnpm --filter @task/web test",
    "smoke": "node scripts/smoke.mjs",
    "check:prod-guard": "node scripts/check-prod-guard.mjs"
  },
  "devDependencies": {
    "cf": "0.15.0",
    "typescript": "5.9.3"
  }
}
