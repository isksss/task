{
  "name": "task",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @task/web build && pnpm --filter @task/api dev",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --filter @task/web build && pnpm --filter @task/api build",
    "test": "pnpm --filter @task/api test && pnpm --filter @task/web test",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/smoke.mjs --e2e",
    "check:prod-guard": "node scripts/check-prod-guard.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "cf": "0.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "5.9.3"
  }
}
